{
  "name": "jectable",
  "version": "1.0.0",
  "description": "Mock without dependency injection or module mocking",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./production": {
      "import": "./dist/production.js",
      "require": "./dist/production.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "0BSD",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "test": "vp test",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-perfectionist": "^5.12.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}
